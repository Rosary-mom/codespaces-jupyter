import os
import requests
from io import BytesIO
from PIL import Image as PILImage

# Automatischer Download eines kleinen Demo-Sets echter Geniza-Fragmente
os.makedirs('geniza_patches/Ashkenazic_Square', exist_ok=True)
os.makedirs('geniza_patches/Oriental_Cursive', exist_ok=True)
os.makedirs('geniza_patches/Ashkenazic_Cursive', exist_ok=True)

# Öffentliche Beispiele (Wikimedia + bekannte Geniza-Quellen)
demo_images = {
    'Ashkenazic_Square': [
        'https://upload.wikimedia.org/wikipedia/commons/thumb/8/8e/Hebrew_manuscript.jpg/800px-Hebrew_manuscript.jpg',
    ],
    'Oriental_Cursive': [
        'https://upload.wikimedia.org/wikipedia/commons/thumb/5/5e/Cairo_Geniza_fragment.jpg/800px-Cairo_Geniza_fragment.jpg',
    ],
    'Ashkenazic_Cursive': [
        'https://upload.wikimedia.org/wikipedia/commons/thumb/0/0e/Ashkenazi_Hebrew_manuscript.jpg/800px-Ashkenazi_Hebrew_manuscript.jpg',
    ]
}

for klasse, urls in demo_images.items():
    for i, url in enumerate(urls):
        try:
            response = requests.get(url, timeout=10)
            img = PILImage.open(BytesIO(response.content)).convert('RGB')
            img.save(f'geniza_patches/{klasse}/demo_{i}.jpg')
            print(f"✅ Heruntergeladen: {klasse}/demo_{i}.jpg")
        except Exception as e:
            print(f"⚠️ Download fehlgeschlagen für {klasse}: {e}")

# Datensatz laden
